{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "BlobStorage": {
    "ConnectionString": "PUT_YOUR_STORAGE_CONNECTION_STRING_HERE",
    "ContainerName": "uploaded-images"
  },

  "ComputerVision": {
    "Endpoint": "https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com/",
    "Key": "PUT_YOUR_COMPUTER_VISION_KEY_HERE"
  },

  "CacheSettings": {
    "AbsoluteExpirationMinutes": 60
  }
}
