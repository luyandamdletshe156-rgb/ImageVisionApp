@{
    ViewData["FullBleed"] = false;
}

<div class="hero reveal">
    <div class="hero-copy">
        <p class="intro-eyebrow hero-eyebrow">Powered by Azure Computer Vision</p>
        <h1 class="hero-title">See what's inside your photos.</h1>
        <p class="hero-desc">
            Upload any picture and the AI writes a plain-English description, picks out the key details, and tells you exactly how confident it is.
        </p>
        <div class="hero-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-shutter large">
                <span class="btn-text">Start Analyzing</span>
            </a>
            <a asp-controller="Home" asp-action="History" class="text-link">View your past photos &rarr;</a>
        </div>
    </div>

    <div class="cube-stage" aria-hidden="true">
        <div class="cube">
            <div class="cube-face front"><span class="cube-dot"></span></div>
            <div class="cube-face back"><span class="cube-dot"></span></div>
            <div class="cube-face right"><span class="cube-dot"></span></div>
            <div class="cube-face left"><span class="cube-dot"></span></div>
            <div class="cube-face top"><span class="cube-dot"></span></div>
            <div class="cube-face bottom"><span class="cube-dot"></span></div>
        </div>
    </div>
</div>

<div class="capability-grid reveal-up delay-1">
    <div class="capability tilt-3d">
        <div class="capability-mark mark-lime"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></div>
        <h2 class="capability-title">Easy uploads</h2>
        <p class="capability-text">Drag and drop any photo from your computer. Most standard formats work, up to 4MB.</p>
    </div>
    <div class="capability tilt-3d">
        <div class="capability-mark mark-magenta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg></div>
        <h2 class="capability-title">Smart memory</h2>
        <p class="capability-text">Analyze the same photo twice and it's pulled straight from the archive — no repeat wait.</p>
    </div>
    <div class="capability tilt-3d">
        <div class="capability-mark mark-signal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div>
        <h2 class="capability-title">Clear descriptions</h2>
        <p class="capability-text">No JSON to decode — you get one plain sentence that explains what's happening in the picture.</p>
    </div>
</div>

