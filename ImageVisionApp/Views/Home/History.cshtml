@model IReadOnlyList<ImageVisionApp.Models.HistoryEntry>

<div class="intro reveal">
    <p class="intro-eyebrow">Your History</p>
    <h1 class="intro-title">Photos you've analyzed.</h1>
    <p class="intro-desc">A private record of every picture you've checked, numbered in the order you shot them. Delete one here and it's gone for good.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-frame reveal-up delay-1">
        <div class="empty-icon">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <p class="empty-text">You haven't analyzed any photos yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-shutter">
            <span class="btn-text">Try your first photo</span>
        </a>
    </div>
}
else
{
    <div class="archive-controls reveal-up delay-1">
        <span class="meter-tag">@Model.Count photos saved</span>
        <form asp-controller="Home" asp-action="ClearHistory" method="post" onsubmit="return confirm('Are you sure you want to delete all your history? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="text-link danger">Clear All History</button>
        </form>
    </div>

    <div class="contact-sheet reveal-up delay-2">
        @for (int i = 0; i < Model.Count; i++)
        {
            var entry = Model[i];
            var frameNumber = (Model.Count - i).ToString("D3");
            <article class="frame-card tilt-3d">
                <div class="frame-card-image">
                    <img src="@entry.ImageUrl" alt="@entry.Description" loading="lazy" />
                    <span class="frame-index">No. @frameNumber</span>
                    @if (entry.FromCache)
                    {
                        <span class="meter-tag frame-cached">Archived</span>
                    }
                    <form asp-controller="Home" asp-action="DeleteHistoryEntry" asp-route-id="@entry.Id" method="post" class="frame-delete" onsubmit="return confirm('Delete this photo from your history?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-delete" title="Delete Photo">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </form>
                </div>
                <div class="frame-meta">
                    <p class="frame-desc">&ldquo;@entry.Description&rdquo;</p>
                    <div class="frame-stats">
                        <span class="match">@entry.ConfidenceScore.ToString("P0") confident</span>
                        <span>@entry.CreatedAtUtc.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                    </div>
                    @if (entry.Tags.Any())
                    {
                        <ul class="tag-row frame-tags">
                            @foreach (var tag in entry.Tags.Take(3))
                            {
                                <li class="tag-chip">@tag</li>
                            }
                        </ul>
                    }
                </div>
            </article>
        }
    </div>
}
