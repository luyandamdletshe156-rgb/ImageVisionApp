@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vision Lab | AI Photo Analyzer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="stage">
        <aside class="camera-body">
            <a asp-controller="Home" asp-action="Home" class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="10" width="36" height="24" rx="4" fill="#141726" stroke="#5C6278" stroke-width="1.5" />
                        <circle cx="20" cy="22" r="9" fill="#0E1020" stroke="#A6FF4D" stroke-width="2" />
                        <circle cx="20" cy="22" r="4" fill="#A6FF4D" />
                        <rect x="12" y="6" width="10" height="6" rx="1.5" fill="#141726" stroke="#5C6278" stroke-width="1.5" />
                        <circle cx="32" cy="16" r="1.6" fill="#FF4FA3" />
                    </svg>
                </span>
                <span class="brand-name">
                    <span class="brand-title">Vision Lab</span>
                    <span class="brand-subtitle">AI Photo Analyzer</span>
                </span>
            </a>

            <nav class="dial-nav">
                <a asp-controller="Home" asp-action="Home" class="dial-item @(IsActive("Home") ? "active" : "")">
                    <span class="dial-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
                    Home
                </a>
                <a asp-controller="Home" asp-action="Index" class="dial-item @(IsActive("Index") || IsActive("Upload") ? "active" : "")">
                    <span class="dial-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></span>
                    Analyze a Photo
                </a>
                <a asp-controller="Home" asp-action="History" class="dial-item @(IsActive("History") ? "active" : "")">
                    <span class="dial-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="13" rx="1.5"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></span>
                    Your History
                </a>
                <a asp-controller="Home" asp-action="About" class="dial-item @(IsActive("About") ? "active" : "")">
                    <span class="dial-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg></span>
                    How it Works
                </a>
            </nav>

            <div class="body-footer">
                <span class="ready-light"></span>
                <span>AI ready</span>
            </div>
        </aside>

        <div class="viewport">
            <div class="film-rail" data-edge="VISION-LAB · TYPE 4"></div>
            <main class="viewport-frame">
                @RenderBody()
            </main>
            <div class="film-rail" data-edge="AZURE COMPUTER VISION"></div>
        </div>
    </div>

    <script src="~/js/site.js"></script>
</body>
</html>
